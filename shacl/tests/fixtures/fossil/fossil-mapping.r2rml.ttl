# The RDF meaning of a fossil/1 corpus, in R2RML (https://www.w3.org/TR/r2rml/).
# Every table and column is a delimited identifier, unqualified: resolve the names against the
# database the corpus is attached to.
@prefix rr: <http://www.w3.org/ns/r2rml#> .

<#map/Person> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "\"Person\"" ] ;
  rr:subjectMap [ rr:column "\"subject\"" ; rr:termType rr:IRI ; rr:class <http://example.org/Person> ] ;
  rr:predicateObjectMap [ rr:predicate <http://example.org/name> ; rr:objectMap [ rr:column "\"name\"" ; rr:termType <http://www.w3.org/ns/r2rml#Literal> ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] ;
  rr:predicateObjectMap [ rr:predicate <http://example.org/born> ; rr:objectMap [ rr:column "\"born\"" ; rr:termType <http://www.w3.org/ns/r2rml#Literal> ; rr:datatype <http://www.w3.org/2001/XMLSchema#dateTime> ] ] ;
  rr:predicateObjectMap [ rr:predicate <http://example.org/birthday> ; rr:objectMap [ rr:column "\"birthday\"" ; rr:termType <http://www.w3.org/ns/r2rml#Literal> ; rr:datatype <http://www.w3.org/2001/XMLSchema#date> ] ] ;
  rr:predicateObjectMap [ rr:predicate <http://example.org/wakes> ; rr:objectMap [ rr:column "\"wakes\"" ; rr:termType <http://www.w3.org/ns/r2rml#Literal> ; rr:datatype <http://www.w3.org/2001/XMLSchema#time> ] ] ;
  rr:predicateObjectMap [ rr:predicate <http://example.org/photo> ; rr:objectMap [ rr:column "\"photo\"" ; rr:termType <http://www.w3.org/ns/r2rml#Literal> ; rr:datatype <http://www.w3.org/2001/XMLSchema#hexBinary> ] ] ;
  rr:predicateObjectMap [ rr:predicate <http://example.org/score> ; rr:objectMap [ rr:column "\"score\"" ; rr:termType <http://www.w3.org/ns/r2rml#Literal> ; rr:datatype <http://www.w3.org/2001/XMLSchema#double> ] ] .

<#map/acme.Org> a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "\"acme.Org\"" ] ;
  rr:subjectMap [ rr:column "\"subject\"" ; rr:termType rr:IRI ; rr:class <http://example.org/Org> ] ;
  rr:predicateObjectMap [ rr:predicate <http://example.org/label> ; rr:objectMap [ rr:column "\"label\"" ] ] .

<#map/Person_worksFor_acme.Org> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT s.\"subject\" AS \"source\", d.\"subject\" AS \"destination\"\nFROM \"Person_worksFor_acme.Org\" AS e\nJOIN \"Person\" AS s ON e.\"src\" = s.\"dense_id\"\nJOIN \"acme.Org\" AS d ON e.\"dst\" = d.\"dense_id\"" ; rr:sqlVersion rr:SQL2008 ] ;
  rr:subjectMap [ rr:column "\"source\"" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate <http://example.org/worksFor> ; rr:objectMap [ rr:column "\"destination\"" ; rr:termType rr:IRI ] ] .

<#map/Person_tag> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT s.\"subject\" AS \"source\", e.\"tag\" AS \"value\"\nFROM \"Person_tag\" AS e\nJOIN \"Person\" AS s ON e.\"src\" = s.\"dense_id\"" ; rr:sqlVersion rr:SQL2008 ] ;
  rr:subjectMap [ rr:column "\"source\"" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate <http://example.org/tag> ; rr:objectMap [ rr:column "\"value\"" ; rr:termType <http://www.w3.org/ns/r2rml#Literal> ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] .
